# Set environment variables in your shell; this file is documentation, not auto-loaded.
# Use the full endpoint URL for any compatible chat-completions API.
PROMO_API_URL=https://router.huggingface.co/v1/chat/completions
PROMO_MODEL=YOUR_AVAILABLE_MODEL_ID
PROMO_API_KEY=YOUR_KEY
# Local Ollama alternative (requires a locally installed model):
# PROMO_API_URL=http://localhost:11434/api/chat
# PROMO_MODEL=YOUR_LOCAL_MODEL
# PROMO_API_STYLE=ollama

# Completion budget includes reasoning for reasoning models. Default: 4096.
# PROMO_MAX_OUTPUT_TOKENS=4096

# Save/reuse private completed responses in outputs/ai-checkpoints/. Default: enabled.
# PROMO_CACHE=0

# Automatic rate-limit waiting budget per episode, across at most two retries.
# Default: 3600 seconds. Range: 0 (disable waiting) to 86400.
# PROMO_MAX_RATE_WAIT_SECONDS=3600
